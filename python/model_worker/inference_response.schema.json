{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-proxy.local/model_worker/inference_response.schema.json",
  "title": "Model worker POST /infer success response",
  "description": "Contract for the Python model worker inference response. Carries only spans, labels, confidence and model source. No source text, tokenization artifacts, reversible mappings, or keys.",
  "type": "object",
  "required": ["entities"],
  "additionalProperties": false,
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "start", "end", "confidence", "model"],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "model": {
            "type": "string",
            "enum": ["rubert", "gliner"]
          }
        }
      }
    }
  }
}