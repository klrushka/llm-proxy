{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/pii-corpus.schema.json",
  "title": "PII synthetic corpus",
  "description": "Local synthetic corpus for the PII protection service. Only explicitly synthetic data is allowed.",
  "type": "object",
  "required": ["version", "offset_unit", "cases"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "offset_unit": {
      "type": "string",
      "const": "utf8_byte"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "input", "expected_mask", "spans"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string"
          },
          "expected_mask": {
            "type": "string"
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "start", "end", "value", "personal"],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "value": {
                  "type": "string"
                },
                "personal": {
                  "type": "boolean"
                },
                "mask_token": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}